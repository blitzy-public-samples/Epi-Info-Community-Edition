    {
      "id": "LY-02",
      "form": "CaseReport",
      "event": "Sex.After",
      "given": {
        "Sex": "2",
        "Pregnant": "1"
      },
      "expect": {
        "Pregnant": {
          "enabled": false,
          "value": null
        }
      },
      "source": "metaViews.CheckCode (CaseReport): Field Sex After / Field LastName Before",
      "legacyDefect": true,
      "inScope": true,
      "note": "codeSex \"1\" = Male, \"2\" = Female, so the legacy rule disables Pregnant for females. Parity keeps this unless listed under Approved Behavior Changes."
