  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "mssql": "^12.8.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
