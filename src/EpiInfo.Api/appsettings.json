{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Web": {
    "ClientPath": "../../web/dist"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
